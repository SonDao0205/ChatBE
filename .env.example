PORT=8082
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
# Production Neon URL. Keep empty in this example file.
DATABASE_URL=

# Local PostgreSQL configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=FILL_DATABASE_USERNAME
DB_PASSWORD=FILL_DATABASE_PASSWORD
DB_NAME=omnichannel_pos

# Generate these values locally and keep them out of Git.
# Must match ManagementBE app.marketplace.credential-encryption-key.
MARKETPLACE_CREDENTIAL_ENCRYPTION_KEY=FILL_SHARED_MARKETPLACE_ENCRYPTION_KEY
TIKTOK_OAUTH_CLIENT_ID=omni-tiktok-local
TIKTOK_OAUTH_CLIENT_SECRET=FILL_TIKTOK_CLIENT_SECRET
LAZADA_OAUTH_CLIENT_ID=omni-lazada-local
LAZADA_OAUTH_CLIENT_SECRET=FILL_LAZADA_CLIENT_SECRET

# Must match AI_backend CHAT_BACKEND_SERVICE_TOKEN. Keep server-side only.
CHAT_BACKEND_SERVICE_TOKEN=FILL_SHARED_CHAT_SERVICE_TOKEN

# Chat Backend triggers AI for new inbound messages whose conversation is AUTO.
AI_BACKEND_URL=http://localhost:8083
AI_SERVICE_TOKEN=FILL_SHARED_AI_SERVICE_TOKEN
AI_REQUEST_TIMEOUT_MS=45000

# Durable autopilot queue. Start Redis before Chat Backend.
REDIS_URL=redis://127.0.0.1:6379/0
SHOP_KNOWLEDGE_CACHE_TTL_SECONDS=3600
SHOP_KNOWLEDGE_REFRESH_INTERVAL_MS=30000

# Shop catalog vector index used before AI answers product questions.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_MS=5000
SHOP_CATALOG_QDRANT_COLLECTION=omnichannel_shop_catalog_64_v1
AI_AUTOPILOT_DEBOUNCE_MS=750
AI_WORKER_CONCURRENCY=4
AI_JOB_ATTEMPTS=2
AI_JOB_BACKOFF_MS=1000
AI_MONTHLY_TOKEN_LIMIT=2000000
CUSTOMER_PROFILE_DEBOUNCE_MS=5000
POST_PURCHASE_CARE_ENABLED=true
# Runs once per day at 08:00 Asia/Ho_Chi_Minh and selects orders delivered 2 days ago.

# Stored with each AI run for audit. Provider secrets remain only in AI_backend.
LLM_PROVIDER=stub
LLM_MODEL=stub
